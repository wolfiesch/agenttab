# Secret masking values for the native host (policy key: secretMaskFile).
#
# Copy to bridge_secrets.txt, chmod 600, and point a policy section at it:
#   "secretMaskFile": "/absolute/path/to/bridge_secrets.txt"
#
# One `name=value` pair per line. Blank lines and `#` comments are ignored.
# Every exact occurrence of a value is replaced with <masked:name> in every
# outbound response string and in every audit-log field, so a credential typed
# into a page can never be echoed back to a client or persisted to disk.
# Masking is independent of the policy `redact` toggle.
#
# bridge_secrets.txt is gitignored. Never commit real values.
demo-api-key=replace-me-with-a-real-value

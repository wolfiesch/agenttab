{
  "manifest_version": 3,
  "name": "AgentTab",
  "short_name": "AgentTab",
  "version": "2.0.0",
  "version_name": "2.0.0-rc.1",
  "description": "A local browser runtime for task-owned automation in your signed-in Chrome profile.",
  "minimum_chrome_version": "127",
  "permissions": [
    "nativeMessaging",
    "debugger",
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "AgentTab",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

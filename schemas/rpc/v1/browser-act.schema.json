{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenttab.dev/schemas/rpc/v1/browser-act.schema.json",
  "title": "browser_act parameters",
  "$defs": {
    "ref": { "type": "string", "minLength": 1, "maxLength": 256 },
    "selector": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "frame_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "url": { "type": "string", "maxLength": 2048, "pattern": "^(https?://|about:)[^\\s]+$" },
    "action": {
      "oneOf": [
        { "$ref": "#/$defs/click" },
        { "$ref": "#/$defs/hover" },
        { "$ref": "#/$defs/double_click" },
        { "$ref": "#/$defs/context_click" },
        { "$ref": "#/$defs/press" },
        { "$ref": "#/$defs/type" },
        { "$ref": "#/$defs/fill" },
        { "$ref": "#/$defs/select" },
        { "$ref": "#/$defs/scroll" },
        { "$ref": "#/$defs/drag" },
        { "$ref": "#/$defs/navigate" },
        { "$ref": "#/$defs/history" },
        { "$ref": "#/$defs/reload" },
        { "$ref": "#/$defs/close" },
        { "$ref": "#/$defs/dialog" },
        { "$ref": "#/$defs/upload_file" }
      ]
    },
    "click": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "const": "click" },
        "ref": { "$ref": "#/$defs/ref" },
        "selector": { "$ref": "#/$defs/selector" },
        "frame_id": { "$ref": "#/$defs/frame_id" },
        "expect_download": { "type": "boolean", "default": false }
      },
      "oneOf": [
        { "required": ["ref"] },
        { "required": ["selector"] }
      ],
      "additionalProperties": false
    },
    "hover": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "const": "hover" },
        "ref": { "$ref": "#/$defs/ref" },
        "selector": { "$ref": "#/$defs/selector" },
        "frame_id": { "$ref": "#/$defs/frame_id" }
      },
      "oneOf": [
        { "required": ["ref"] },
        { "required": ["selector"] }
      ],
      "additionalProperties": false
    },
    "double_click": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "const": "double_click" },
        "ref": { "$ref": "#/$defs/ref" },
        "selector": { "$ref": "#/$defs/selector" },
        "frame_id": { "$ref": "#/$defs/frame_id" },
        "expect_download": { "type": "boolean", "default": false }
      },
      "oneOf": [
        { "required": ["ref"] },
        { "required": ["selector"] }
      ],
      "additionalProperties": false
    },
    "context_click": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "const": "context_click" },
        "ref": { "$ref": "#/$defs/ref" },
        "selector": { "$ref": "#/$defs/selector" },
        "frame_id": { "$ref": "#/$defs/frame_id" },
        "expect_download": { "type": "boolean", "default": false }
      },
      "oneOf": [
        { "required": ["ref"] },
        { "required": ["selector"] }
      ],
      "additionalProperties": false
    },
    "press": {
      "type": "object",
      "required": ["kind", "key"],
      "properties": {
        "kind": { "const": "press" },
        "ref": { "$ref": "#/$defs/ref" },
        "selector": { "$ref": "#/$defs/selector" },
        "frame_id": { "$ref": "#/$defs/frame_id" },
        "expect_download": { "type": "boolean", "default": false },
        "key": {
          "enum": [
            "ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight", "Enter", "Escape",
            "Tab", "Home", "End", "Space", "Backspace", "Delete", "a", "z", "y"
          ]
        },
        "modifiers": {
          "type": "array",
          "items": { "enum": ["Alt", "Control", "Meta", "Shift"] },
          "maxItems": 4,
          "uniqueItems": true
        }
      },
      "oneOf": [
        { "required": ["ref"] },
        { "required": ["selector"] }
      ],
      "additionalProperties": false
    },
    "type": {
      "type": "object",
      "required": ["kind", "text"],
      "properties": {
        "kind": { "const": "type" },
        "ref": { "$ref": "#/$defs/ref" },
        "selector": { "$ref": "#/$defs/selector" },
        "frame_id": { "$ref": "#/$defs/frame_id" },
        "text": { "type": "string", "maxLength": 2048 }
      },
      "oneOf": [
        { "required": ["ref"] },
        { "required": ["selector"] }
      ],
      "additionalProperties": false
    },
    "fill": {
      "type": "object",
      "required": ["kind", "text"],
      "properties": {
        "kind": { "const": "fill" },
        "ref": { "$ref": "#/$defs/ref" },
        "selector": { "$ref": "#/$defs/selector" },
        "frame_id": { "$ref": "#/$defs/frame_id" },
        "text": { "type": "string", "maxLength": 2048 }
      },
      "oneOf": [
        { "required": ["ref"] },
        { "required": ["selector"] }
      ],
      "additionalProperties": false
    },
    "select": {
      "type": "object",
      "required": ["kind", "ref", "value"],
      "properties": {
        "kind": { "const": "select" },
        "ref": { "$ref": "#/$defs/ref" },
        "frame_id": { "$ref": "#/$defs/frame_id" },
        "value": { "type": "string", "maxLength": 2048 }
      },
      "additionalProperties": false
    },
    "scroll": {
      "type": "object",
      "required": ["kind", "delta_x", "delta_y"],
      "properties": {
        "kind": { "const": "scroll" },
        "ref": { "$ref": "#/$defs/ref" },
        "frame_id": { "$ref": "#/$defs/frame_id" },
        "delta_x": { "type": "integer", "minimum": -100000, "maximum": 100000 },
        "delta_y": { "type": "integer", "minimum": -100000, "maximum": 100000 }
      },
      "additionalProperties": false
    },
    "drag": {
      "type": "object",
      "required": ["kind", "ref", "target_ref"],
      "properties": {
        "kind": { "const": "drag" },
        "ref": { "$ref": "#/$defs/ref" },
        "target_ref": { "$ref": "#/$defs/ref" },
        "frame_id": { "$ref": "#/$defs/frame_id" }
      },
      "additionalProperties": false
    },
    "navigate": {
      "type": "object",
      "required": ["kind", "url"],
      "properties": {
        "kind": { "const": "navigate" },
        "url": { "$ref": "#/$defs/url" },
        "expect_download": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "history": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["go_back", "go_forward"] },
        "expect_download": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "reload": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "const": "reload" },
        "bypass_cache": { "type": "boolean", "default": false },
        "expect_download": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "close": {
      "type": "object",
      "required": ["kind"],
      "properties": { "kind": { "const": "close" } },
      "additionalProperties": false
    },
    "dialog": {
      "type": "object",
      "required": ["kind", "decision"],
      "properties": {
        "kind": { "const": "dialog" },
        "decision": { "enum": ["accept", "dismiss"] },
        "prompt_text": { "type": "string", "maxLength": 4096 }
      },
      "allOf": [
        {
          "if": { "required": ["prompt_text"] },
          "then": { "properties": { "decision": { "const": "accept" } } }
        }
      ],
      "additionalProperties": false
    },
    "upload_file": {
      "type": "object",
      "required": ["kind", "files"],
      "properties": {
        "kind": { "const": "upload_file" },
        "ref": { "$ref": "#/$defs/ref" },
        "selector": { "$ref": "#/$defs/selector" },
        "frame_id": { "$ref": "#/$defs/frame_id" },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      },
      "oneOf": [
        { "required": ["ref"] },
        { "required": ["selector"] }
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["tab_id", "expected_page_revision", "actions"],
  "properties": {
    "tab_id": { "type": "integer", "minimum": 0 },
    "expected_page_revision": { "type": "integer", "minimum": 0 },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/action" }
    }
  },
  "additionalProperties": false
}

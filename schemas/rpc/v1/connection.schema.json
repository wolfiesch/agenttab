{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenttab.dev/schemas/rpc/v1/connection.schema.json",
  "title": "AgentTab Core RPC v1 connection negotiation",
  "oneOf": [
    {
      "type": "object",
      "required": ["protocol", "version", "kind"],
      "properties": {
        "protocol": { "const": "agenttab.rpc" },
        "version": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "kind": { "const": "connect" },
        "conversation_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "resume_capability": { "type": "string", "minLength": 32, "maxLength": 64 },
        "supported_versions": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        },
        "supported_features": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 128 },
          "maxItems": 64,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["protocol", "version", "kind", "connection_id", "resumed", "state"],
      "properties": {
        "protocol": { "const": "agenttab.rpc" },
        "version": { "const": 1 },
        "kind": { "const": "connected" },
        "connection_id": { "type": "string", "format": "uuid" },
        "resumed": { "type": "boolean" },
        "task_id": { "type": "string", "format": "uuid" },
        "resume_capability": { "type": "string", "minLength": 32, "maxLength": 64 },
        "state": { "enum": ["starting", "reconciling", "ready", "paused", "terminal"] },
        "features": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 128 },
          "maxItems": 64,
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "resumed": { "const": true } },
            "required": ["resumed"]
          },
          "then": {
            "required": ["task_id", "resume_capability"]
          }
        }
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["protocol", "version", "kind", "connection_id", "resume_capability"],
      "properties": {
        "protocol": { "const": "agenttab.rpc" },
        "version": { "const": 1 },
        "kind": { "const": "resume_confirm" },
        "connection_id": { "type": "string", "format": "uuid" },
        "resume_capability": { "type": "string", "minLength": 32, "maxLength": 64 }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["protocol", "version", "kind", "connection_id"],
      "properties": {
        "protocol": { "const": "agenttab.rpc" },
        "version": { "const": 1 },
        "kind": { "const": "resume_confirmed" },
        "connection_id": { "type": "string", "format": "uuid" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "protocol",
        "version",
        "kind",
        "requested_protocol",
        "requested_version",
        "supported_versions",
        "message",
        "recovery"
      ],
      "properties": {
        "protocol": { "const": "agenttab.rpc" },
        "version": { "const": 1 },
        "kind": { "const": "incompatible" },
        "requested_protocol": { "type": "string", "maxLength": 128 },
        "requested_version": { "type": "integer", "minimum": 0 },
        "supported_versions": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "minItems": 1,
          "uniqueItems": true
        },
        "message": { "type": "string", "minLength": 1 },
        "recovery": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  ]
}

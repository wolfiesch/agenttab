{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenttab.dev/schemas/rpc/v1/browser-credentials.schema.json",
  "title": "browser_credentials parameters",
  "$defs": {
    "ref": { "type": "string", "minLength": 1, "maxLength": 256 },
    "target": {
      "type": "object",
      "required": ["action", "tab_id", "expected_page_revision", "credential_token"],
      "properties": {
        "action": { "enum": ["fill", "next"] },
        "tab_id": { "type": "integer", "minimum": 0 },
        "expected_page_revision": { "type": "integer", "minimum": 0 },
        "credential_token": { "type": "string", "minLength": 32, "maxLength": 256 },
        "username_ref": { "$ref": "#/$defs/ref" },
        "password_ref": { "$ref": "#/$defs/ref" },
        "otp_ref": { "$ref": "#/$defs/ref" }
      },
      "anyOf": [
        { "required": ["username_ref"] },
        { "required": ["password_ref"] },
        { "required": ["otp_ref"] }
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": ["action", "tab_id", "expected_page_revision"],
      "properties": {
        "action": { "const": "prepare" },
        "tab_id": { "type": "integer", "minimum": 0 },
        "expected_page_revision": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    { "$ref": "#/$defs/target" }
  ]
}

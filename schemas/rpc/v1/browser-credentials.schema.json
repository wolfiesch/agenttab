{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenttab.dev/schemas/rpc/v1/browser-credentials.schema.json",
  "title": "browser_credentials parameters",
  "$defs": {
    "ref": { "type": "string", "minLength": 1, "maxLength": 256 },
    "target": {
      "type": "object",
      "required": ["action", "tab_id", "expected_page_revision", "credential_token"],
      "properties": {
        "action": { "enum": ["fill", "next"] },
        "tab_id": { "type": "integer", "minimum": 0 },
        "expected_page_revision": { "type": "integer", "minimum": 0 },
        "credential_token": { "type": "string", "minLength": 32, "maxLength": 256 },
        "username_ref": { "$ref": "#/$defs/ref" },
        "password_ref": { "$ref": "#/$defs/ref" },
        "otp_ref": { "$ref": "#/$defs/ref" }
      },
      "anyOf": [
        { "required": ["username_ref"] },
        { "required": ["password_ref"] },
        { "required": ["otp_ref"] }
      ],
      "additionalProperties": false
    },
    "email_code": {
      "description": "Fill a brokered email verification code from one managed mailbox message. Carries no credential, code value, origin, or mailbox query; the host derives the origin and path from the task tab. A compatible masked recipient is accepted when it fits the exact granted recipient and no conflicting address is shown.",
      "type": "object",
      "required": ["action", "tab_id", "expected_page_revision", "message_id", "recipient", "purpose", "otp_refs"],
      "properties": {
        "action": { "const": "fill_email" },
        "tab_id": { "type": "integer", "minimum": 0 },
        "expected_page_revision": { "type": "integer", "minimum": 0 },
        "message_id": {
          "description": "Gmail message ID of the verification email.",
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[0-9A-Fa-f]{1,128}$"
        },
        "recipient": {
          "description": "Exact email address the verification code was sent to.",
          "type": "string",
          "minLength": 3,
          "maxLength": 320,
          "pattern": "^[!-+\\--:=?A-~]{1,64}@[!-+\\--:=?A-~]{1,255}$"
        },
        "purpose": { "enum": ["signup", "email_sign_in"] },
        "otp_refs": {
          "description": "Code input refs in code-character order: one ref for a single code input, or one ref per code character.",
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/ref" }
        }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": ["action", "tab_id", "expected_page_revision"],
      "properties": {
        "action": { "const": "prepare" },
        "tab_id": { "type": "integer", "minimum": 0 },
        "expected_page_revision": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    { "$ref": "#/$defs/target" },
    { "$ref": "#/$defs/email_code" }
  ]
}

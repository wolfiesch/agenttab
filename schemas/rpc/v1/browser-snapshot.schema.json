{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenttab.dev/schemas/rpc/v1/browser-snapshot.schema.json",
  "title": "browser_snapshot parameters",
  "oneOf": [
    {
      "type": "object",
      "required": ["tab_id", "mode"],
      "properties": {
        "tab_id": { "type": "integer", "minimum": 0 },
        "mode": { "const": "accessibility" },
        "root_ref": { "type": "string", "minLength": 1, "maxLength": 256 },
        "max_depth": { "type": "integer", "minimum": 1, "maximum": 200 },
        "max_nodes": { "type": "integer", "minimum": 1, "maximum": 5000 }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["tab_id", "mode"],
      "properties": {
        "tab_id": { "type": "integer", "minimum": 0 },
        "mode": { "enum": ["text", "html"] },
        "selector": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "match": { "enum": ["first", "last"], "default": "first" },
        "max_bytes": { "type": "integer", "minimum": 1, "maximum": 1000000 }
      },
      "dependentRequired": { "match": ["selector"] },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["tab_id", "mode"],
      "properties": {
        "tab_id": { "type": "integer", "minimum": 0 },
        "mode": { "const": "screenshot" },
        "selector": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "full_page": { "type": "boolean", "default": false },
        "format": { "enum": ["png", "jpeg", "webp"], "default": "png" },
        "quality": { "type": "integer", "minimum": 0, "maximum": 100 },
        "max_width": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "max_height": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "max_bytes": { "type": "integer", "minimum": 1, "maximum": 750000 }
      },
      "allOf": [
        {
          "if": { "required": ["quality"] },
          "then": {
            "required": ["format"],
            "properties": { "format": { "enum": ["jpeg", "webp"] } }
          }
        },
        {
          "not": {
            "required": ["selector", "full_page"],
            "properties": { "full_page": { "const": true } }
          }
        }
      ],
      "additionalProperties": false
    }
  ]
}
